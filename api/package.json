{
  "name": "usdc-ops-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "test": "NODE_ENV=test OPENAI_API_KEY= ANTHROPIC_API_KEY= INBOUND_EMAIL_DOMAIN=bills.decimal.test RESEND_INBOUND_WEBHOOK_SECRET=\"whsec_$(printf 'decimal-test-only-not-a-secret' | base64)\" tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/client": "^6.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@sqds/multisig": "^2.1.4",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
